{
  "name": "@blwatkins/utils",
  "version": "0.1.0-alpha.3",
  "license": "MIT",
  "private": false,
  "description": "A toolkit of general-purpose TypeScript and JavaScript utilities, including validation, mathematical operations, random number generation, random selection, and type-safe guards.",
  "author": {
    "name": "Brittni Watkins",
    "url": "https://blwatkins.github.io/"
  },
  "homepage": "https://blwatkins.github.io/typescript-utils/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blwatkins/typescript-utils.git"
  },
  "bugs": {
    "url": "https://github.com/blwatkins/typescript-utils/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.23.0 || >=24"
  },
  "types": "./_dist/index.d.mts",
  "module": "./_dist/index.mjs",
  "main": "./_dist/index.mjs",
  "exports": {
    ".": {
      "types": "./_dist/index.d.mts",
      "default": "./_dist/index.mjs"
    }
  },
  "files": [
    "./_dist",
    "./LICENSE",
    "./package.json",
    "./README.md"
  ],
  "scripts": {
    "lint:js": "eslint -c eslint.config.js.mjs .",
    "lint:ts": "eslint -c eslint.config.ts.mjs .",
    "lint:all": "npm run lint:js && npm run lint:ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "docs": "typedoc",
    "build": "tsdown",
    "prepack": "npm run build",
    "validate": "npm run lint:all && npm run docs && npm run build && npm test"
  },
  "dependencies": {
    "typebox": "^1.3.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-es-x": "^10.0.0",
    "eslint-plugin-jsdoc": "^63.2.2",
    "globals": "^17.7.0",
    "tsdown": "^0.22.14",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "typescript",
    "javascript",
    "utility",
    "utilities",
    "utils",
    "type-guard",
    "validation",
    "type-assertion",
    "math",
    "number",
    "string",
    "random",
    "seeded-random",
    "weighted-random",
    "prng",
    "pseudorandom",
    "deterministic",
    "xoshiro",
    "xoshiro128",
    "esm"
  ]
}
