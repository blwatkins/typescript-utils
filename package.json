{
  "name": "@blwatkins/utils",
  "version": "0.1.0-alpha.3",
  "license": "MIT",
  "private": false,
  "description": "A toolkit of general-purpose TypeScript and JavaScript utilities.",
  "author": {
    "name": "Brittni Watkins",
    "url": "https://blwatkins.github.io/"
  },
  "homepage": "https://blwatkins.github.io/typescript-utils/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blwatkins/typescript-utils.git"
  },
  "bugs": {
    "url": "https://github.com/blwatkins/typescript-utils/issues"
  },
  "funding": [
    {
      "type": "individual",
      "url": "https://github.com/sponsors/blwatkins"
    }
  ],
  "type": "module",
  "engines": {
    "node": "^22.23.0 || >=24"
  },
  "types": "./_dist/index.d.mts",
  "module": "./_dist/index.mjs",
  "main": "./_dist/index.mjs",
  "exports": {
    ".": {
      "types": "./_dist/index.d.mts",
      "default": "./_dist/index.mjs"
    }
  },
  "files": [
    "./_dist",
    "./LICENSE",
    "./package.json",
    "./README.md"
  ],
  "scripts": {
    "lint:js": "eslint -c eslint.config.js.mjs .",
    "lint:ts": "eslint -c eslint.config.ts.mjs .",
    "lint:all": "npm run lint:js && npm run lint:ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "docs": "typedoc",
    "build": "tsdown",
    "prepack": "npm run build",
    "validate": "npm run lint:all && npm run docs && npm run build && npm test"
  },
  "dependencies": {
    "typebox": "^1.3.19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-es-x": "^10.0.0",
    "eslint-plugin-jsdoc": "^64.2.1",
    "globals": "^17.11.0",
    "tsdown": "^0.22.14",
    "typedoc": "^0.28.20",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "typescript",
    "javascript",
    "utility",
    "utilities",
    "utils",
    "esm"
  ]
}
